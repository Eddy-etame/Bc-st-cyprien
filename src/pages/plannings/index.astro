  <main id="main">

    <!-- ========================= EN-TÊTE ========================== -->
    <header class="phero" aria-label="Le planning">
      <div class="phero__spot" aria-hidden="true"></div>
      <div class="wrap">
        <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span aria-hidden="true">/</span> <span aria-current="page">Planning</span></nav>
        <p class="eyebrow" data-reveal id="pl-season" style="margin-top:1.1rem">Saison 2026 — 2027 · Rive gauche</p>
        <h1 class="display"><span class="reveal-mask"><span>La semaine,</span></span><span class="reveal-mask"><span class="tint">au cordeau.</span></span></h1>
        <p class="lead" data-reveal>Filtre par jour, discipline ou coach — la grille se règle sous tes yeux. Le poster officiel de la saison, plus bas, fait foi.</p>
        <div class="phero__mark" aria-hidden="true"></div>
      </div>
    </header>

    <!-- ==================== FILTRES + GRILLE ====================== -->
    <section class="section pl-wrap" aria-label="La grille des cours">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(1.4rem,3vw,2rem)">
          <span class="eyebrow">La grille</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(1.8rem,4vw,2.8rem)">Ta semaine, réglée.</h2>
        </div>
        <div class="pl-pulse" id="pl-pulse" data-reveal-group aria-label="La semaine en chiffres"></div>
        <div class="filters" id="filters" role="group" aria-label="Filtrer le planning"></div>
        <div class="pl-bar">
          <p class="pl-count" id="pl-count" role="status" aria-live="polite"></p>
          <button class="pl-reset" id="pl-reset" type="button" hidden>Tout réafficher</button>
        </div>
        <div class="pgrid" id="grid"></div>
        <p class="pl-empty" id="pl-empty" hidden>Aucun cours ne correspond à ces trois filtres réunis. <button class="pl-empty__reset" type="button">Repars de la semaine entière</button></p>
      </div>
    </section>

    <!-- ======================= LE POSTER ========================= -->
    <section class="section" style="padding-top:0" aria-label="Le poster officiel">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(1.4rem,3vw,2rem)">
          <span class="eyebrow">Le poster officiel</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(1.8rem,4vw,2.8rem)">La source de vérité.</h2>
        </div>
        <!-- Aperçu léger (WebP 800/1600) EN COULEUR ; le poster pleine résolution (source de vérité) reste cliquable via le lien. -->
        <a class="pl-poster" data-reveal href="/assets/img/sc/planning-2026.webp" target="_blank" rel="noopener" aria-label="Ouvrir le planning officiel en pleine résolution, dans un nouvel onglet">
          <!-- Le poster est une grille de texte : c'est le seul cliché du site où
               l'AVIF écrase vraiment le WebP (mesuré : 193 Ko -> 112 Ko à qualité
               identique). Le WebP reste dessous, filet pour qui ne lit pas l'AVIF.
               scripts/build-avif.mjs casse le build si ces .avif manquent. -->
