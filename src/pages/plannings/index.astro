<body data-page="plannings">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= EN-TÊTE ========================== -->
    <header class="phero" aria-label="Le planning">
      <div class="phero__spot" aria-hidden="true"></div>
      <div class="wrap">
        <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span aria-hidden="true">/</span> <span aria-current="page">Planning</span></nav>
        <p class="eyebrow" data-reveal id="pl-season" style="margin-top:1.1rem">Saison 2026 — 2027 · Rive gauche</p>
        <h1 class="display"><span class="reveal-mask"><span>La semaine,</span></span><span class="reveal-mask"><span class="tint">au cordeau.</span></span></h1>
        <p class="lead" data-reveal>Filtre par jour, discipline ou coach — la grille se règle sous tes yeux. Le poster officiel de la saison, plus bas, fait foi.</p>
        <div class="phero__mark" aria-hidden="true"></div>
      </div>
    </header>

    <!-- ==================== FILTRES + GRILLE ====================== -->
    <section class="section pl-wrap" aria-label="La grille des cours">
      <div class="wrap">
        <div class="filters" id="filters" role="group" aria-label="Filtrer le planning"></div>
        <div class="pgrid" id="grid"></div>
        <p class="pl-empty" id="pl-empty" hidden>Aucun cours ne correspond à ce filtre. Enlève-en un.</p>
      </div>
    </section>

    <!-- ======================= LE POSTER ========================= -->
    <section class="section" style="padding-top:0" aria-label="Le poster officiel">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(1.4rem,3vw,2rem)">
          <span class="eyebrow">Le poster officiel</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(1.8rem,4vw,2.8rem)">La source de vérité.</h2>
        </div>
        <!-- Aperçu léger (JPEG 800/1600) EN COULEUR ; le PNG plein format (source de vérité) reste cliquable via le lien. -->
        <a class="pl-poster" data-reveal href="/assets/img/sc/planning-2026.png" target="_blank" rel="noopener" aria-label="Ouvrir le planning officiel en grand format (PNG plein format)">
          <img src="/assets/img/sc/planning-2026-1600.jpg"
               srcset="/assets/img/sc/planning-2026-800.jpg 800w, /assets/img/sc/planning-2026-1600.jpg 1600w"
               sizes="(max-width: 820px) 92vw, min(92vw, 1280px)"
               width="2400" height="1996" alt="Planning des cours saison 2026-2027 de Boxing Center Saint-Cyprien : boxe anglaise, boxe thaï/K1, grappling, Hyrox, cross-training, Lady Punch, boxing camp et école enfants dès 3 ans (Baby Boxe 3/6, éducative 7/11, ados 12/16, compétiteurs), du lundi au samedi." loading="lazy" decoding="async" />
        </a>
      </div>
    </section>

    <!-- ==================== NOTES PRATIQUES ====================== -->
    <section class="section" style="padding-top:0" aria-label="Les notes pratiques">
      <div class="wrap">
        <div data-reveal style="margin-bottom:clamp(1.2rem,2.6vw,1.8rem)">
          <span class="eyebrow">Avant de venir</span>
        </div>
        <div class="pnotes" data-reveal-group>
          <div class="pnote"><b>Arrive 10 min avant</b><span>Le temps de te changer, de dire bonjour au coach et de te préparer sans stress.</span></div>
          <div class="pnote"><b>Matériel prêté</b><span>Gants et protections disponibles à la salle pour la première séance. Viens en tenue de sport.</span></div>
          <div class="pnote"><b>Dernier cours 20h–21h15</b><span>Les créneaux du soir ferment la journée. Fermé le dimanche.</span></div>
          <div class="pnote"><b>Un doute sur un créneau ?</b><span>Appelle la salle au 05 62 24 46 82, on te cale sur le bon cours.</span></div>
        </div>
      </div>
    </section>

    <!-- ========================= FINAL CTA ======================== -->
    <section class="gong" aria-label="Réserver une séance">
      <div class="gong__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Ton créneau est là</span>
        <h2 class="display" style="font-size:clamp(2rem,5vw,3.6rem)"><span class="reveal-mask"><span>Choisis ton cours.</span></span><span class="reveal-mask"><span class="tint">On te met au bon créneau.</span></span></h2>
        <p class="lead" data-reveal>Dix euros, toutes disciplines, sans engagement — tu réserves, on t'attend.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver ma séance · 10€</span></a>
          <a class="btn" data-magnetic href="tel:+33562244682"><span>05 62 24 46 82</span></a>
        </div>
      </div>
    </section>

