<body data-page="home">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ============================ HERO ============================ -->
    <header class="hero" aria-label="Boxing Center Saint-Cyprien">
      <div class="hero__spot" aria-hidden="true"></div>
      <div class="wrap hero__grid">
        <div>
          <p class="eyebrow" data-reveal>Saint-Cyprien · Toulouse rive gauche</p>
          <h1 class="display hero__title"><span class="reveal-mask"><span>La nouvelle génération.</span></span><span class="reveal-mask"><span class="tint">Boxing Center, rive gauche.</span></span></h1>
          <p class="lead hero__sub" data-reveal><b>Quatre salles avant elle.</b> Tout ce qui marche ailleurs est ici, réglé au cordeau — 1 200 m², rive gauche. Choisis ce que la lumière éclaire cette semaine.</p>
          <div class="hero__badges" data-reveal>
            <span>Rive gauche</span>
            <span>1 200 m²</span>
            <span>Métro A · 4 min</span>
            <span>Dès 3 ans</span>
          </div>
          <div class="hero__cta" data-reveal>
            <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Ma 1<sup>re</sup> séance · 10€</span></a>
            <a class="btn" data-magnetic href="#configurateur"><span>Choisir ma discipline</span></a>
          </div>
        </div>
        <div class="hero__media" data-reveal>
          <div class="media hero__photo" data-img="/assets/img/sc/salle-1.webp" data-label="La salle · rive gauche" data-alt="Le plateau Boxing Center Saint-Cyprien : la ligne de sacs, le ring au fond, un seul niveau" data-eager></div>
          <div class="hero__card">
            <i>La nouvelle génération</i>
            <b>Rive gauche</b>
          </div>
        </div>
      </div>
      <div class="wrap">
        <div class="hero__stats" id="stats" data-reveal-group aria-label="La salle en chiffres"></div>
      </div>
    </header>

    <!-- ========================= TICKER =========================== -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track" id="marquee"></div>
    </div>

    <!-- ==================== MANIFESTO — une ligne ================== -->
    <section class="manifesto" aria-label="Le manifeste">
      <div class="wrap">
        <p><span class="reveal-mask"><span>On n'a pas fait une salle neuve.</span></span><span class="reveal-mask"><span class="tint">On a fait la suivante.</span></span></p>
      </div>
    </section>

    <!-- ================= LE CONFIGURATEUR (signature) ============== -->
    <section class="config" id="configurateur" aria-label="Choisir sa discipline">
      <div class="config__bg" id="config-bg" aria-hidden="true"></div>
      <div class="wrap config__grid">
        <div>
          <span class="eyebrow" data-reveal>Le configurateur</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(2.2rem,5vw,4.2rem)"><span class="reveal-mask"><span>La lumière</span></span><span class="reveal-mask"><span class="tint">sur le geste.</span></span></h2>
          <p data-reveal style="max-width:42ch;margin-top:.9rem;color:var(--ink-soft)">Clique une discipline : le coach, les jours et le niveau sortent du planning officiel de la saison. À toi de composer ta semaine.</p>
          <div class="config__list" id="config-list" role="tablist" aria-orientation="vertical" aria-label="Les disciplines"></div>
        </div>
        <div class="config__panel" id="config-panel" role="tabpanel" aria-labelledby="cfg-anglaise" aria-live="polite" data-reveal>
          <div class="config__media" id="config-media"></div>
          <div class="config__body" id="config-body"></div>
        </div>
      </div>
    </section>

    <!-- ===================== TEASER COACHS ======================== -->
    <section class="section coachrow" aria-label="L'encadrement">
      <div class="wrap">
        <div class="coachrow__head" data-reveal>
          <span class="eyebrow">L'encadrement</span>
          <h2 class="display coachrow__title"><span class="reveal-mask"><span>Le petit au Baby Boxe le samedi.</span></span><span class="reveal-mask"><span class="tint">Toi au camp le lundi soir.</span></span></h2>
          <p class="coachrow__lead" data-reveal>Même toit, même adresse. Dadi tient l'anglaise, la Lady Punch et l'école ; Tawee, Victor G et Hicham tiennent le pieds-poings et le moteur.</p>
        </div>
        <div class="coachrow__grid" id="coachrow" data-reveal-group></div>
        <a class="btn coachrow__more" data-magnetic href="/coachs/"><span>Voir les coachs</span></a>
      </div>
    </section>

    <!-- ================== CARTE ESSAI — 10€ seule ================= -->
    <section class="section essai-sec" aria-label="La séance d'essai">
      <div class="wrap">
        <div class="essai" data-reveal>
          <div class="essai__spot" aria-hidden="true"></div>
          <div class="essai__body">
            <span class="eyebrow">La séance d'essai</span>
            <h2 class="display essai__title">Une séance.<br><span class="tint">Dix euros. Tu sauras.</span></h2>
            <p class="lead essai__lead">Toutes disciplines, gants et matériel prêtés, sans engagement. Tu repars en sachant si c'est pour toi.</p>
          </div>
          <div class="essai__cta">
            <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a>
            <a class="btn" data-magnetic href="tel:+33562244682"><span>05 62 24 46 82</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== QUARTIER / ACCÈS ====================== -->
    <section class="section quartier" aria-label="Le quartier & l'accès">
      <div class="wrap quartier__grid">
        <div>
          <span class="eyebrow" data-reveal>Rive gauche</span>
          <h2 class="display quartier__title"><span class="reveal-mask"><span>À 4 minutes</span></span><span class="reveal-mask"><span class="tint">du métro.</span></span></h2>
          <p class="lead quartier__lead" data-reveal>À 4 minutes du métro, l'excuse du trajet ne tient plus. Reste celle du courage — on s'en occupe.</p>
          <a class="btn quartier__cta" data-magnetic href="/contact/"><span>Nous trouver</span></a>
        </div>
        <ul class="quartier__facts" data-reveal-group>
          <li><span class="qk">Adresse</span><span class="qv">11 rue Sainte-Lucie, 31300 Toulouse</span></li>
          <li><span class="qk">Métro</span><span class="qv">Ligne A · Saint-Cyprien République (4 min)</span></li>
          <li><span class="qk">Horaires</span><span class="qv">Lun – Sam · 10h00 – 21h15</span></li>
          <li><span class="qk">Stationnement</span><span class="qv">Parking Saint-Cyprien à proximité</span></li>
        </ul>
      </div>
    </section>

    <!-- ========================= FINAL CTA ========================= -->
    <section class="gong" aria-label="Rejoindre la salle">
      <div class="gong__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Ta première séance</span>
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,4rem)"><span class="reveal-mask"><span>Viens juger sur pièce.</span></span><span class="reveal-mask"><span class="tint">On te prête les gants.</span></span></h2>
        <p class="lead" data-reveal>Première séance 10€, toutes disciplines, sans engagement. 11 rue Sainte-Lucie, métro Saint-Cyprien République.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver ma 1<sup>re</sup> séance</span></a>
          <a class="btn" data-magnetic href="tel:+33562244682"><span>05 62 24 46 82</span></a>
        </div>
      </div>
    </section>

  </main>

