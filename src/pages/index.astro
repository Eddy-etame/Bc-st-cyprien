<body data-page="home">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ============================ HERO ============================ *
         La composition tient en TROIS étages, pas en deux colonnes qui se
         disputent la hauteur : (1) l’accroche pleine largeur — un seul point
         d’entrée pour l'œil ; (2) la ligne de front, où la parole et la photo
         partent du MÊME trait horizontal ; (3) la barre de chiffres, qui fait
         la marche vers la suite. L’ancienne version empilait titre + texte +
         badges + boutons dans une colonne de près de mille pixels, et la grille
         centrait la photo au milieu de ce vide : d’où l’image « posée dessous ».
         Ici la photo ne peut plus glisser — elle commence là où la parole
         commence. -->
    <header class="hero" aria-label="Boxing Center Saint-Cyprien">
      <div class="hero__spot" aria-hidden="true"></div>
      <div class="wrap hero__inner">

        <!-- 1. L’ACCROCHE — pleine largeur, calibrée pour tenir en deux lignes -->
        <p class="eyebrow" data-reveal>Saint-Cyprien · Toulouse rive gauche</p>
        <h1 class="display hero__title"><span class="reveal-mask"><span>Toutes les boxes.</span></span><span class="reveal-mask"><span class="tint">Une seule salle.</span></span></h1>

        <!-- 2. LA LIGNE DE FRONT — la parole et la salle, même départ -->
        <div class="hero__front">
          <div class="hero__say">
            <p class="lead hero__sub" data-reveal>Anglaise, thaï, K1, cross-training, muscu et cardio — au 11 rue Sainte-Lucie, rive gauche. Accès libre 7 j/7 et cours collectifs sans réservation, du premier cours à la compétition.</p>
            <div class="hero__cta" data-reveal>
              <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/inscription?product=offre-duo&step=1&utm_source=site&utm_medium=cta&utm_campaign=bc-st-cyprien"><span>Je profite de l’offre — 29€</span></a>
              <a class="btn" data-magnetic href="#configurateur"><span>Voir les cours</span></a>
            </div>
            <p data-reveal style="margin-top:.55rem;font-size:.78rem;letter-spacing:.06em;color:var(--ink-soft)">29€ les 4 semaines · sans engagement · gants prêtés</p>
          </div>
          <div class="hero__media" data-reveal>
            <div class="media hero__photo" data-img="/assets/img/sc/salle-1.webp" data-label="La salle · rive gauche" data-alt="Le plateau Boxing Center Saint-Cyprien : la ligne de sacs, le ring au fond, un seul niveau" data-eager></div>
            <!-- les repères passent SOUS la photo : ils la légendent au lieu de
                 rallonger la colonne de texte. -->
            <div class="hero__badges" data-reveal>
              <span>Accès libre 7 j/7</span>
              <span>1 200 m²</span>
              <span>Métro A · 4 min</span>
              <span>Dès 3 ans</span>
            </div>
          </div>
        </div>

        <!-- 3. LA MARCHE — les chiffres ferment le héros et appellent la suite -->
        <div class="hero__stats" id="stats" data-reveal-group aria-label="La salle en chiffres"></div>
      </div>
    </header>

    <!-- ========================= TICKER =========================== -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track" id="marquee"></div>
    </div>

    <!-- ==================== MANIFESTO — une ligne ================== -->
    <section class="manifesto band-light" aria-label="Le manifeste">
      <div class="wrap">
        <p><span class="reveal-mask"><span>La cinquième salle du réseau.</span></span><span class="reveal-mask"><span class="tint">La première en centre-ville.</span></span></p>
      </div>
    </section>

    <!-- ================= LE CONFIGURATEUR (signature) ============== -->
    <section class="config" id="configurateur" aria-label="Choisir sa discipline">
      <div class="config__bg" id="config-bg" aria-hidden="true"></div>
      <div class="wrap config__grid">
        <div>
          <span class="eyebrow" data-reveal>Le configurateur</span>
          <h2 class="display" style="margin-top:1rem;font-size:clamp(2.2rem,5vw,4.2rem)"><span class="reveal-mask"><span>Trouve</span></span><span class="reveal-mask"><span class="tint">ton cours.</span></span></h2>
          <p data-reveal style="max-width:42ch;margin-top:.9rem;color:var(--ink-soft)">Passe la liste : les jours, le coach et le niveau s’affichent. Première fois ? Dis-le au coach du créneau, il s’occupe de toi.</p>
          <div class="config__list" id="config-list" role="tablist" aria-orientation="vertical" aria-label="Les disciplines"></div>
        </div>
        <div class="config__panel" id="config-panel" role="tabpanel" aria-labelledby="cfg-anglaise" aria-live="polite" data-reveal>
          <div class="config__media" id="config-media"></div>
          <div class="config__body" id="config-body"></div>
        </div>
      </div>
    </section>

    <!-- ============== LE CADRAN DES OFFRES (roulette.js) =============
         Posé ici : le configurateur : la discipline est choisie, reste le prix. Le module remplit `[data-roulette]` ; sans
         JavaScript, il n'y a rien — donc rien de cassé. -->
    <div class="rdial-band">
      <div class="wrap"><div data-roulette></div></div>
    </div>


    <!-- ===================== TEASER COACHS ======================== -->
    <section class="section coachrow" aria-label="L’encadrement">
      <div class="wrap">
        <div class="coachrow__head" data-reveal>
          <span class="eyebrow">L’encadrement</span>
          <h2 class="display coachrow__title"><span class="reveal-mask"><span>Le petit au Baby Boxe le samedi.</span></span><span class="reveal-mask"><span class="tint">Toi au camp le lundi soir.</span></span></h2>
          <p class="coachrow__lead" data-reveal>Même toit, même adresse. Dadi tient l’anglaise, la Lady Punch et l’école ; Tawee, Victor G et Hicham tiennent le pieds-poings et le moteur.</p>
        </div>
        <div class="coachrow__grid" id="coachrow" data-reveal-group></div>
        <a class="btn coachrow__more" data-magnetic href="/coachs/"><span>Voir les coachs</span></a>
      </div>
    </section>

    <!-- ================== CARTE ESSAI — 10€ seule ================= -->
    <section class="section essai-sec" aria-label="La séance d’essai">
      <div class="wrap">
        <div class="essai" data-reveal>
          <div class="essai__spot" aria-hidden="true"></div>
          <div class="essai__body">
            <span class="eyebrow">L’offre de rentrée</span>
            <h2 class="display essai__title">Quatre semaines.<br><span class="tint">29€. Par personne.</span></h2>
            <p class="lead essai__lead">Cours illimités, toutes disciplines de la salle, sans engagement — au lieu de <s class="was">44€</s>. Tu viens avec ton binôme si tu veux : chacun sa place, chacun ses gants.</p>
            <!-- Le compteur de places : vide et masqué à la livraison, il ne
                 s'ouvre que si la boutique a donné le nombre RÉEL de places
                 encore libres. Rien n'est écrit en dur ici. -->
            <p class="places" data-places hidden></p>
          </div>
          <div class="essai__cta">
            <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/inscription?product=offre-duo&step=1&utm_source=site&utm_medium=cta&utm_campaign=bc-st-cyprien"><span>Je prends ma place de rentrée — 29€</span></a>
            <a class="btn" data-magnetic href="tel:+33562244682"><span>05 62 24 46 82</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== QUARTIER / ACCÈS ====================== -->
    <section class="section quartier" aria-label="Le quartier & l’accès">
      <div class="wrap quartier__grid">
        <div>
          <span class="eyebrow" data-reveal>Rive gauche</span>
          <h2 class="display quartier__title"><span class="reveal-mask"><span>À 4 minutes</span></span><span class="reveal-mask"><span class="tint">du métro.</span></span></h2>
          <p class="lead quartier__lead" data-reveal>À 4 minutes du métro, l’excuse du trajet ne tient plus. Reste celle du courage — on s’en occupe.</p>
          <a class="btn quartier__cta" data-magnetic href="/contact/"><span>Nous trouver</span></a>
        </div>
        <ul class="quartier__facts" data-reveal-group>
          <li><span class="qk">Adresse</span><span class="qv">11 rue Sainte-Lucie, 31300 Toulouse</span></li>
          <li><span class="qk">Métro</span><span class="qv">Ligne A · Saint-Cyprien République (4 min)</span></li>
          <li><span class="qk">Horaires</span><span class="qv">Lun – Sam · 10h00 – 21h15</span></li>
          <li><span class="qk">Stationnement</span><span class="qv">Parking Saint-Cyprien à proximité</span></li>
        </ul>
      </div>
    </section>

    <!-- ========================= FINAL CTA ========================= -->
    <section class="gong" aria-label="Rejoindre la salle">
      <div class="gong__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Ta première séance</span>
        <h2 class="display" style="font-size:clamp(2.2rem,5vw,4rem)"><span class="reveal-mask"><span>Viens juger sur pièce.</span></span><span class="reveal-mask"><span class="tint">On te prête les gants.</span></span></h2>
        <p class="lead" data-reveal>Première séance 10€, toutes disciplines, sans engagement. 11 rue Sainte-Lucie, métro Saint-Cyprien République.</p>
