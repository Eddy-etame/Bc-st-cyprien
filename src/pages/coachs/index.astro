<body data-page="coachs">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ========================= EN-TÊTE ========================== -->
    <header class="phero" aria-label="Les coachs">
      <div class="phero__spot" aria-hidden="true"></div>
      <div class="wrap">
        <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span aria-hidden="true">/</span> <span aria-current="page">Coachs</span></nav>
        <p class="eyebrow" data-reveal style="margin-top:1.1rem">L'encadrement · 4 noms au planning</p>
        <h1 class="display"><span class="reveal-mask"><span>Un pilier.</span></span><span class="reveal-mask"><span class="tint">Trois spécialistes.</span></span></h1>
        <p class="lead" data-reveal>Les noms viennent du planning officiel, pas d'un catalogue. Dadi tient le fil rouge — l'anglaise, la Lady Punch, toute l'école. Tawee, Hicham et Victor G tiennent leur surface : le pieds-poings et le moteur.</p>
        <div class="phero__mark" aria-hidden="true"></div>
      </div>
    </header>

    <!-- ==================== LE PILIER — Dadi ====================== -->
    <section class="section coachlead-sec" aria-label="Dadi — le pilier">
      <div class="wrap">
        <div class="coachlead" id="coachlead"></div>
      </div>
    </section>

    <!-- ==================== LES SPÉCIALISTES ====================== -->
    <section class="section roster-sec" aria-label="Les spécialistes">
      <div class="wrap">
        <div class="roster-sec__head" data-reveal>
          <span class="eyebrow">Les spécialistes</span>
          <h2 class="display roster-sec__title">Le faisceau passe d'un coach à l'autre.</h2>
          <p class="roster-sec__lead">Trois noms du planning, chacun sur sa surface. Pas de photo tant qu'on ne peut pas la prouver — la lumière, elle, ne triche pas.</p>
        </div>
        <div class="roster" id="roster"></div>
        <p class="roster__note" data-reveal>Les portraits arrivent au fur et à mesure. On ne met jamais un visage sous un nom qu'on ne peut pas garantir.</p>
      </div>
    </section>

    <!-- ========================= FINAL CTA ======================== -->
    <section class="gong" aria-label="Réserver une séance">
      <div class="gong__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Le meilleur moyen de les connaître</span>
        <h2 class="display" style="font-size:clamp(2rem,5vw,3.6rem)"><span class="reveal-mask"><span>Monte sur le ring</span></span><span class="reveal-mask"><span class="tint">avec eux.</span></span></h2>
        <p class="lead" data-reveal>Une séance suffit pour savoir qui te corrige et comment. Dix euros, toutes disciplines.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver mon essai · 10€</span></a>
          <a class="btn" data-magnetic href="/plannings/"><span>Voir le planning</span></a>
        </div>
      </div>
    </section>

  </main>

