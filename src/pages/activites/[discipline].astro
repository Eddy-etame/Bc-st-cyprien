      <a href="https://www.facebook.com/BoxingCenterToulouse/">Facebook Boxing Center</a>
      <a href="/mentions-legales/">Mentions légales</a>
    </nav>
  </div>

  <!-- chatbot — pointe vers du réel (tél de la salle) -->
  <a class="chatbot" href="tel:+33562244682" aria-label="Une question ? Appelle la salle Boxing Center Saint-Cyprien">
    <span class="chatbot__icon" aria-hidden="true"><svg width="36" height="36" viewBox="0 0 24 24" fill="none"><mask id="bc-m-st-cyprien" maskUnits="userSpaceOnUse"><rect width="24" height="24" fill="#fff"/><path d="M7.4 9.7 11.0 9.9 11.0 11.7 7.4 11.4Z" fill="#000"/><path d="M16.6 9.7 13.0 9.9 13.0 11.7 16.6 11.4Z" fill="#000"/><rect x="10.1" y="14.8" width="3.8" height="1.4" rx=".65" fill="#000"/></mask><path d="M3.6 8.4H2.1v4.2h1.5ZM20.4 8.4h1.5v4.2h-1.5Z" fill="currentColor"/><path d="M4.4 12.9a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" fill="currentColor"/><path d="M19.6 12.9a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" fill="currentColor"/><path d="M12 1.2C7 1.2 3.6 4.3 3.6 8.6v6c0 1.9 1 3.3 2.7 4.1l.9 3.1a.55.55 0 0 1 .8.63l3.6-2.2c.13.01.27.02.4.02 4.6 0 8.4-2.3 8.4-5.9v-6c0-4.3-3.4-7.4-8.4-7.4Z" fill="currentColor" mask="url(#bc-m-st-cyprien)"/></svg></span>
    <span class="chatbot__label">Une question&nbsp;? Appelle la salle</span>
  </a>

  <!-- Libs d’animation, auto-hébergées et regroupées (gsap + ScrollTrigger + Lenis). -->
  <script is:inline defer src="/assets/js/vendor.min.js?v=22"></script>
  <script is:inline type="module" src="/assets/js/site.js?v=29"></script>
  <script is:inline type="module" src="/assets/js/discipline.js?v=3"></script>
</body>
</html>
